{
  "name": "tgloader",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram bot that downloads videos from YouTube, VK, Rutube, Instagram and TikTok",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop tgloader",
    "pm2:restart": "pm2 restart tgloader",
    "pm2:logs": "pm2 logs tgloader"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "ffmpeg-static": "^5.2.0",
    "grammy": "^1.36.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sql.js": "^1.14.2",
    "youtube-dl-exec": "^3.0.22"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
