BOT_TOKEN=123456:replace-with-token-from-BotFather

# Optional. Comma-separated Telegram user ids. Empty = anyone can use the bot.
ALLOWED_USER_IDS=

# Optional. Netscape cookies.txt (helps with Instagram / TikTok / some YouTube videos).
COOKIES_FILE=

# Optional. Load cookies from a local browser instead of a file.
# Examples: chrome, edge, firefox
COOKIES_FROM_BROWSER=

# Fallback max height when the user does not pick a format.
MAX_HEIGHT=720

# Logging (pino). Levels: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Pretty logs in a terminal are on by default. Set 0 for JSON, 1 to force pretty.
# LOG_PRETTY=0
