BOT_TOKEN=123456:replace-with-token-from-BotFather

# Необязательно. Telegram user id через запятую. Пусто = бот доступен всем.
ALLOWED_USER_IDS=

# Telegram user id владельца бота — сюда в ЛС приходит ежедневный отчёт аналитики.
# Свой id можно узнать у @userinfobot или аналогичного бота.
ADMIN_USER_ID=

# Расписание ежедневного отчёта (часовой пояс ниже). По умолчанию: 05:00.
# REPORT_HOUR=5
# REPORT_MINUTE=0
# REPORT_TIMEZONE=Asia/Bangkok

# Путь к базе SQLite с аналитикой (относительно корня проекта).
# ANALYTICS_DB_PATH=data/analytics.db

# Необязательно. Файл cookies.txt в формате Netscape (помогает с Instagram / TikTok / частью YouTube).
COOKIES_FILE=

# Необязательно. Загрузить cookies из локального браузера вместо файла.
# Примеры: chrome, edge, firefox
COOKIES_FROM_BROWSER=

# Максимальная высота по умолчанию, если пользователь не выбрал формат.
MAX_HEIGHT=720

# Автообновление yt-dlp при старте (не чаще раза в сутки). 0 = выключить.
# YTDLP_AUTO_UPDATE=1
# YTDLP_UPDATE_INTERVAL_HOURS=24
# YTDLP_UPDATE_TIMEOUT_SEC=120

# Логирование (pino). Уровни: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Читаемые логи в терминале включены по умолчанию. 0 = JSON, 1 = принудительно pretty.
# LOG_PRETTY=0
